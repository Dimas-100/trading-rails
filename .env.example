# Copy to .env (gitignored). Only needed for the Webull adapter.
WEBULL_APP_KEY=your_app_key_here
WEBULL_APP_SECRET=your_app_secret_here
WEBULL_REGION=us
WEBULL_HOST=api.webull.com
# Where the SDK stores its 2FA token. Use an ABSOLUTE path if you run from more than one directory.
WEBULL_OPENAPI_TOKEN_DIR=.webull-tokens
# Arming flag for real submission. Leave 0/unset for dry-run. This file is loaded from the CURRENT WORKING
# DIRECTORY (python-dotenv), so a "1" here arms the Webull adapter (armed()==True) the moment this .env is
# loaded -- even before you pass --live on the command line. Even armed, --live still asks for a typed
# CONFIRM per order, but leaving this at 1 silently removes the broker-arming wall, so keep it 0 unless you
# deliberately mean to arm.
RAILS_LIVE_ENABLED=0
